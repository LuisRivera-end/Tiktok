# Entorno escolar controlado. No usar estos valores fuera del laboratorio.
APP_NAME=Veta
APP_ENV=lab
SECRET_KEY=veta-lab-secret-change-in-this-machine-only
ACCESS_TOKEN_EXPIRE_MINUTES=720

POSTGRES_USER=veta
POSTGRES_PASSWORD=veta
POSTGRES_DB=veta
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://veta:veta@localhost:5432/veta

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=veta_telemetry
MONGODB_URL=mongodb://localhost:27017

API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

VITE_API_URL=http://localhost:8000

# heuristic | shadow | mmoe; promotion requires a validated real-data artifact.
CONTENT_MODEL_MODE=heuristic
ADS_MODEL_MODE=heuristic
MMOE_MODEL_PATH=artifacts/mmoe/model.json
